{
  "name": "boost-backend",
  "version": "0.1.3",
  "description": "Backend Boost: specs, agents, skills, prompts, and evals for backend reasoning.",
  "type": "module",
  "exports": {
    "./boost.json": "./boost.json",
    "./package.json": "./package.json"
  },
  "files": [
    "boost.json",
    "agents",
    "specs",
    "skills",
    "prompts",
    "evals",
    "examples",
    "docs",
    "instructions",
    "README.md",
    "LICENSE",
    "scripts",
    ".github/copilot-instructions.md"
  ],
  "scripts": {
    "check:structure": "node scripts/check-structure.js",
    "check:refs": "node scripts/validate-references.js",
    "check:evals": "node scripts/validate-evals.js",
    "check:alignment": "node scripts/validate-artifact-alignment.js",
    "check:placeholders": "node scripts/check-placeholders.js",
    "quality": "npm run check:structure && npm run check:refs && npm run check:evals && npm run check:alignment && npm run check:placeholders",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "boost:install": "node scripts/install.mjs",
    "boost:check": "node scripts/install.mjs --check"
  },
  "keywords": [
    "boost",
    "backend",
    "agents",
    "skills",
    "specs",
    "clean-architecture",
    "ddd",
    "api-design",
    "copilot",
    "github-copilot",
    "agent-skills"
  ],
  "author": "Sergio Hierro Cinos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sertxito/boost_backend.git"
  },
  "bugs": {
    "url": "https://github.com/Sertxito/boost_backend/issues"
  },
  "homepage": "https://github.com/Sertxito/boost_backend#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^11.0.3",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^24.2.7"
  },
  "bin": {
    "boost-backend": "scripts/install.mjs"
  }
}
